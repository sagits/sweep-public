# Vercel's build image runs its own bundled pnpm, picked from the lockfile version.
# Left to itself, that pnpm sees packageManager=pnpm@12.3.4 and tries to self-install
# the 12.3.4 engine into package-manager-store, which fails in the build sandbox:
#   × the installed pnpm wrapper is missing at .../pnpm-engine-12.3.4-.../node_modules/pnpm
# Lockfile 9.0 installs fine under the bundled pnpm, so switch the self-install off.
manage-package-manager-versions=false
