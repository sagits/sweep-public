{
  "extends": [
    "expo/tsconfig.base",
    "@sweep/config/tsconfig.base.json"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "ios",
    "android",
    "e2e"
  ]
}
